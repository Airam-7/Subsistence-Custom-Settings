<Window x:Class="SCS.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subsistence Custom Settings 2.0.5" Icon="Assets/app.ico" Width="1160" Height="810" MinWidth="980" MinHeight="690" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,14">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/app-icon.png" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="SUBSISTENCE" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="CUSTOM SETTINGS" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Width="280"><TextBlock x:Name="EditingLabel" Text="Editing profile" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="ProfilePicker"/><TextBlock x:Name="IdentityLabel" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Nav}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,22,12,16">
        <DockPanel><StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="{StaticResource Line}" Margin="10,12"/><TextBlock x:Name="InstallBadge" Text="Installation not configured" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0"/><TextBlock Text="v2.0.5 · Custom profiles" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,8,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer></DockPanel>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="34,28,34,30"/></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel x:Name="FooterActions" Orientation="Horizontal" VerticalAlignment="Center"/><StackPanel Margin="12,0,0,0"><Button x:Name="SaveAllButton" Content="Save all"/><TextBlock x:Name="GlobalDirty" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></StackPanel></Grid>
    </Border>
  </Grid>
</Window>
